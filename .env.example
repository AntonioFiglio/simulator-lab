# Copie para apps/web/.env.local. Supabase hospedado é obrigatório; não há banco local.
SUPABASE_URL=
# Chave secret (sb_secret_...) de servidor. Nunca use NEXT_PUBLIC_ para este valor.
SUPABASE_SECRET_KEY=
# Compatibilidade opcional: SUPABASE_SERVICE_ROLE_KEY no lugar de SUPABASE_SECRET_KEY.
# Chave de criptografia estável: gere com openssl rand -hex 32 e guarde em local seguro.
SIMULA_ENCRYPTION_KEY=
# Necessária antes de disponibilizar a aplicação fora de localhost.
SIMULA_ACCESS_PASSWORD=

# Provedor opcional compatível com chat completions JSON.
# OFFER_AI_URL=https://seu-provedor/v1/chat/completions
# OFFER_AI_KEY=<credencial do provedor>
# OFFER_AI_MODEL=<modelo com saída JSON>

# Piloto opcional: desligado por padrão. Requer executor dedicado.
SIMULA_AGENT_MODE=false
SIMULA_BASE_URL=http://127.0.0.1:3000
# SIMULA_SESSION: cookie da sessão de teste; fornecer só ao executor, nunca versionar.
